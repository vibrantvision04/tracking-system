# --- Database ---
DB_DSN=postgres://gps:password@localhost:5432/gpsdb

# --- Redis (Local Docker) ---
REDIS_URL=redis://localhost:6379
REDIS_ADDR=localhost:6379

# --- Ports ---
GPS_TCP_PORT=5027
HTTP_PORT=8080
WS_PORT=8081

# --- Settings ---
WORKER_POOL_SIZE=8
BATCH_SIZE=200
BATCH_TIMEOUT_MS=5000
BATCH_BUFFER_CEILING=5000
LOG_LEVEL=info
GOMEMLIMIT=400MiB
GOGC=50

# --- Authentication ---
JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars-long
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,https://tracking-system-rosy.vercel.app

# --- Map Matching (Valhalla) ---
ENABLE_MAP_MATCHING=false
MAP_MATCHING_DEBUG=false
VALHALLA_URL=http://localhost:8002
MAP_MATCHING_CACHE_TTL_HOURS=24
