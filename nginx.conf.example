# =========================================================================
# Nginx Reverse Proxy Config for GPS Tracking API & WebSocket
# Place in: /etc/nginx/sites-available/tracking-api
# =========================================================================

# Upstream definition for the Go backend container running on 127.0.0.1:8080
upstream tracking_backend {
    server 127.0.0.1:8080;
    keepalive 32; # Keep-alive connections to Go server to minimize latency
}

server {
    listen 80;
    server_name api.yourdomain.com; # REPLACE WITH YOUR SUBDOMAIN (e.g., api.tracking.com)

    # Increase body limit for large CSV/KMZ/JSON uploads
    client_max_body_size 20M;

    # Gzip settings for fast payload compression
    gzip on;
    gzip_types application/json text/plain text/css application/javascript;
    gzip_min_length 1000;

    # Route: HTTP Rest API
    location /api/ {
        proxy_pass http://tracking_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection ""; # Clear Connection header for keep-alive
        
        # Headers to forward client details to Go backend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeout controls
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Route: WebSockets for real-time tracking playback
    location /ws/track {
        proxy_pass http://tracking_backend/ws/track;
        proxy_http_version 1.1;
        
        # Enable WebSocket connection upgrading
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Long read/send timeouts to prevent connections from dropping
        proxy_read_timeout 86400s; 
        proxy_send_timeout 86400s;
    }
}
